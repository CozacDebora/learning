<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="listaCarti" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="titlu"/>
                <field name="autor"/>
                <field name="gen"/>
                <field name="dataPublicarii"/>
                <field name="numarulPaginii"/>
                <field name="disponibilitate"/>
            </list>
        </field>
    </record>


    <record id="veziFormularCarte" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="titlu"/>
                        <field name="autor"/>
                        <field name="gen"/>
                        <field name="dataPublicarii"/>
                        <field name="numarulPaginii"/>
                        <field name="disponibilitate"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <record id="deschideListaCarti" model="ir.actions.act_window">
        <field name="name">Carti</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>