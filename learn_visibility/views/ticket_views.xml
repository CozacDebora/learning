#"Am o listă de sesizări. 
# Fiecare are un loc unde scriu care e problema. 
# Când bifez că sesizarea e rezolvată, nu mai vreau să văd textul cu problema — e degeaba pe ecran atunci. Se poate?"

<odoo>
    <record id="action_learn_ticket" model="ir.actions.act_window">
        <field name="name">Sesizari</field>
        <field name="res_model">learn.ticket</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_learn_ticket_form" model="ir.ui.view">
        <field name="name">learn.ticket.form</field>
        <field name="model">learn.ticket</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_resolved"/>
                        <field name="problem" invisible="is_resolved"/> 
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_learn_ticket_list" model="ir.ui.view">
        <field name="name">learn.ticket.list</field>
        <field name="model">learn.ticket</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="is_resolved"/>
                <field name="problem" invisible="is_resolved"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_learn_ticket_root" name="Sesizari"/>
    <menuitem id="menu_learn_ticket"
              name="Lista sesizari"
              parent="menu_learn_ticket_root"
              action="action_learn_ticket"/>
</odoo>