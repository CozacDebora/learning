#Creează un modul care extinde partenerul standard. 
Un partener trebuie să aibă un număr de puncte de loialitate și un nivel 
(bronze / silver / gold) care se calculează automat din puncte. 
Nivelul trebuie să poată fi folosit la filtrare și grupare. 
Câmpurile trebuie să fie vizibile în fișa partenerului.

Criterii de acceptare:

Punctele pornesc de la 0 la un partener nou.
Nivelul se recalculează singur când se schimbă punctele (nu se editează manual).
#Se poate grupa lista de parteneri după nivel.


<odoo>
<!-- Modific res.partner -->
    <record id="veziResPartner" model="ir.ui.view">
        <field name="name">veziResPartner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>

        <field name="arch" type="xml">

          <xpath expr="//field[@name='category_id']" position ="after">
            <field name="puncteLoialitate"/>
            <field name="nivelDeLoialitate"/>
          </xpath>

        </field>
    </record>

<!-- Modific lista res.partner -->
    <record id="veziListaResPartner" model = "ir.ui.view">
        <field name = "name">veziListaResPartner</field>
        <field name = "model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>

        <field name="arch" type="xml">

          <xpath expr="//field[@name='category_id']" position="after">
            <field name="puncteLoialitate"/>
            <field name="nivelDeLoialitate"/>
          </xpath>

        </field>
            
    </record>

    <record id="cautareResPartener" model = "ir.ui.view">
        <field name = "name">cautareResPartener</field>
        <field name = "model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_filter"/>

        <field name="arch" type="xml">

          <xpath expr="//search" position="inside">

                <filter 
                     name="filterBronz"
                     string="Bronz"
                     domain="[('nivelDeLoialitate', '=', 'bronz')]"
                />   

                <filter 
                     name="filterArgint"
                     string="Argint"
                     domain="[('nivelDeLoialitate', '=', 'argint')]"
                />


                <filter 
                     name="filterAur"
                     string="Aur"
                     domain="[('nivelDeLoialitate', '=', 'aur')]"
                />

            <group expand="0" string="Group By">

                <filter 
                     name = "groupByNivelDeLoialitate"
                     string = "Nivel de loialitate"
                     context="{'group_by': 'nivelDeLoialitate'}"
                />

            </group>

          </xpath>
        </field>
            
    </record>


</odoo>